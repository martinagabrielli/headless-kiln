# Leave GRAPHQL_ENDPOINT empty to run on the bundled demo content (fixture mode).
# With the local WordPress from ../wordpress running:
GRAPHQL_ENDPOINT=http://localhost:8888/graphql

# Public URL of this site, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match the constants in ../wordpress/.wp-env.json (or wp-config.php).
REVALIDATION_SECRET=local-revalidation-secret
PREVIEW_SECRET=local-preview-secret
ENQUIRY_SECRET=local-enquiry-secret

# Printed by `npm run seed` in ../wordpress. Needed only for previews.
WP_PREVIEW_USER=
WP_PREVIEW_PASSWORD=
