{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/gallery",
    "title": "Gallery",
    "description": "Images with captions.",
    "category": "kiln",
    "icon": "format-gallery",
    "keywords": [
        "images",
        "photos"
    ],
    "acf": {
        "blockVersion": 3,
        "mode": "preview",
        "renderCallback": "kiln_render_block_preview"
    },
    "supports": {
        "align": false,
        "html": false,
        "anchor": true
    }
}
